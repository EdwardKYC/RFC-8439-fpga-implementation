set company "NCKU_CSIE"
set designer "student"

set LIB_DIR "/usr/cad/designkit/CBDK_TSMC40_Arm_f2.0/CIC/SynopsysDC/db/sc9_base_rvt"
set search_path "$LIB_DIR . $search_path"

# 2. 指定 Target Library (請務必確認檔名是否完全正確，通常包含 ss, v0p81, 125c 等關鍵字)
# 這裡建議只放 slow (ss) 庫來做 Worst-case 分析
set target_library "sc9_12lp_base_rvt_ss_v0p81_125c.db"

# 3. 指定 Link Library (加入 dw_foundation 對你的 130-bit 乘法器非常有幫助)
set link_library "* $target_library dw_foundation.sldb"
set synthetic_library "dw_foundation.sldb"

# 4. 針對 Verilog 輸出的優化設定 (從你的範例繼承)
set verilogout_no_tri true
set hdlin_translate_off_skip_text "TRUE"
set bus_inference_style {%s[%d]}
set bus_naming_style {%s[%d]}
set hdlout_internal_busses true

# 5. 命名規則設定 (確保合成後的 Netlist 在 VCS GLS 模擬時不會噴錯)
define_name_rules name_rule -allowed {a-z A-Z 0-9 _} -max_length 255 -type cell
define_name_rules name_rule -allowed {a-z A-Z 0-9 _[]} -max_length 255 -type net
define_name_rules name_rule -map {{"\\*cell\\*" "cell"}}

# 6. 其他 Shell 環境設定
set sh_enable_line_editing true
set sh_line_editing_mode emacs
history keep 100
alias h history

# 指定 WORK 目錄
define_design_lib WORK -path ./WORK